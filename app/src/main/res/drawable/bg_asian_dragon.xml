<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B71C1C"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="300"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#E53935"
                android:endColor="#00000000" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#1A000000"
                android:centerColor="#00000000"
                android:endColor="#1AFFFFFF" />
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#FFD54F" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#FFCA28" android:dashWidth="8dp" android:dashGap="4dp" />
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
