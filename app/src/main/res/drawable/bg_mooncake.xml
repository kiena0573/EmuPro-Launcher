<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3E2723"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="400"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#8D6E63"
                android:endColor="#00000000" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#4DFFCA28" />
        </shape>
    </item>
    
    <item android:top="16dp" android:bottom="16dp" android:left="16dp" android:right="16dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#FFCA28" android:dashWidth="10dp" android:dashGap="5dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="#FFCA28" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
