<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E7D32"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#1B5E20"
                android:endColor="#4CAF50" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Vertical strip (string on banh chung) -->
    <item android:left="30dp" android:right="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    
    <!-- Horizontal strip (string on banh chung) -->
    <item android:top="30dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#A5D6A7" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
