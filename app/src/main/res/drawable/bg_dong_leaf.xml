<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#558B2F"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#33691E"
                android:endColor="#8BC34A" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Leaf veins pattern -->
    <item android:left="-20dp" android:right="-20dp" android:top="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="#22FFFFFF"
                android:centerColor="#00000000"
                android:endColor="#22000000" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#C5E1A5" android:dashWidth="4dp" android:dashGap="2dp" />
            <corners android:radius="16dp"/>
        </shape>
    </item>
</layer-list>
